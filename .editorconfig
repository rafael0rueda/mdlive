# Editor settings the repository follows; Neovim reads them without a plugin
# (:help editorconfig). stylua formats the Lua files (.stylua.toml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
max_line_length = 120

[doc/*.txt]
max_line_length = 78

[Makefile]
indent_style = tab
indent_size = 8

# Exactly what the npm packages contain (make vendor-check): never reformatted.
[app/vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
